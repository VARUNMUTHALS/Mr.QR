# Dynamic QR Studio — Environment Template (Production & Development)
# NOTE: Never prefix sensitive secrets with NEXT_PUBLIC_

# PostgreSQL Connection String (Render / Supabase / Neon / Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dynamic_qr?schema=public"

# NextAuth Configuration
NEXTAUTH_SECRET="generate-a-secure-random-32-char-secret-for-jwt-session"
NEXTAUTH_URL="http://localhost:3000"

# Privacy & Security Keys
ANALYTICS_SALT="rotate-this-secure-salt-for-hmac-sha256-visitor-keys"

# Public App Base URL (Safe for client redirect resolution)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: Redis / Upstash Distributed Rate Limiting (Leave empty to use edge rate limiter)
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
